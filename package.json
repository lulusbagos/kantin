{
  "name": "kantin-dashboard",
  "version": "1.0.0",
  "description": "Aplikasi Dashboard Kasir Kantin Digital",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:exe": "electron-builder --win"
  },
  "author": "Lulus Bagos Hermawan",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "mssql": "^9.1.1",
    "multer": "1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kantin.dashboard",
    "productName": "Kantin Dashboard",
    "files": [
      "src/**/*",
      "database/**/*",
      "uploads/**/*",
      "upload/**/*",
      "package.json"
    ],
    "extraResources": [
      ".env"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir"
      ],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Kantin-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Kantin-Portable-${version}.${ext}"
    }
  }
}
